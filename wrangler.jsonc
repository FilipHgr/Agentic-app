{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nasazení statických souborů z `dist` na Cloudflare Workers.
  // Build vytvoř přes `npm run build`, pak nasaď přes `npm run deploy`.
  "name": "agentic-app",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./dist",
    // Hra je jedna stránka, neznámou cestu obsluhuje index.html.
    "not_found_handling": "single-page-application",
  },
  // Povoluje náhledová nasazení pro neprodukční větve.
  "previews": {},
  // Náhledy dostanou adresu <větev>-agentic-app.<subdomain>.workers.dev.
  "preview_urls": true,
}
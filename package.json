{
  "name": "agentic-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:shared": "vitest run tests/shared/",
    "test:counting": "vitest run tests/games/counting/ tests/shared/boundaries.test.ts --exclude '**/*.slow.test.ts'",
    "test:coloring": "vitest run tests/games/coloring/ tests/shared/boundaries.test.ts --exclude '**/*.slow.test.ts'",
    "test:coloring:slow": "vitest run tests/games/coloring/ --exclude '**/!(*.slow).test.ts'",
    "test:recognition": "vitest run tests/games/counting/ --exclude '**/!(*.slow).test.ts'",
    "test:menu": "vitest run tests/menu/ tests/shared/boundaries.test.ts",
    "test:whole": "vitest run tests/shared/boundaries.test.ts tests/shared/hardcodedTexts.test.ts tests/menu/tileImageFiles.test.ts",
    "test:changed": "node tools/test/runChangedTests.ts",
    "lint": "eslint . && prettier --check .",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler preview",
    "deploy:preview:delete": "wrangler preview delete",
    "voice": "node tools/voice/make_voice.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "6.2.6",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.12",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}

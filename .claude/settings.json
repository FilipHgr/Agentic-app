{
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run dev *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run build)",
      "Bash(npm audit)",
      "Bash(npm audit *)",
      "Bash(npm ci)",
      "Bash(npm ls *)",
      "Bash(npx tsc --noEmit)",
      "Bash(python3 tools/characters/make_characters.py *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin sprint-*)",
      "Bash(git push -u origin sprint-*)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr create *)",
      "Bash(gh pr checks *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(rm *)",
      "Edit(./.github/workflows/**)",
      "Edit(./package.json)",
      "Edit(./.claude/settings.json)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(npm run deploy*)",
      "Bash(*wrangler*)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f*)",
      "Bash(git push *main*)",
      "Bash(git push *staging*)",
      "Bash(gh pr merge *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  }
}

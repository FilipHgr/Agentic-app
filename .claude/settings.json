{
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run dev *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run build)",
      "Bash(npm audit)",
      "Bash(npm audit *)",
      "Bash(npm ci)",
      "Bash(npm ls *)",
      "Bash(npx tsc --noEmit)",
      "Bash(python3 tools/characters/make_characters.py *)",
      "Bash(node tools/design/fetch-image.mjs *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin sprint-*)",
      "Bash(git push -u origin sprint-*)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh pr view *)",
      "Bash(gh pr create *)",
      "Bash(gh pr checks *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(npm run deploy*)",
      "Bash(*wrangler*)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f*)",
      "Bash(git push *main*)",
      "Bash(git push *staging*)",
      "Bash(gh pr merge *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh\"",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-and-lint.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
